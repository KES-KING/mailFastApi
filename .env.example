# =========================
# Secure encrypted store
# =========================
# Required. Used to encrypt/decrypt the SQLite vault at data/mailfastapi-secure.sqlite.
# Generate a long random value and keep it outside source control.
SECURE_STORE_KEY=change_me_with_at_least_32_random_characters
# Optional file source. Prefer this over storing the key directly in .env for production.
SECURE_STORE_KEY_FILE=

# =========================
# API server
# =========================
# true enables fail-fast production safety checks for auth, durable queue, role split, monitor token, and signed updater.
PRODUCTION_MODE=false
# all | api | worker. Production should run api and worker as separate processes.
MAILFASTAPI_ROLE=all
PORT=3000
# JSON body size limit for incoming requests (supports attachments)
REQUEST_BODY_LIMIT=10mb
# Max attachment count accepted by POST /send
MAX_ATTACHMENTS=10
# Max total decoded attachment bytes per request
MAX_ATTACHMENT_TOTAL_BYTES=8388608

# =========================
# Authentication
# =========================
# jwt | api_key | none
AUTH_MODE=jwt

# JWT signing secret (required for AUTH_MODE=jwt)
JWT_SECRET=change_me_with_a_long_random_secret
# JWT issuer/audience must match issue+verify sides
JWT_ISSUER=mailFastApi
JWT_AUDIENCE=mailfastapi-clients
# Token lifetime (examples: 5m, 15m, 1h)
JWT_EXPIRES_IN=5m

# Single default client credentials (jwt mode)
AUTH_CLIENT_ID=webapp-default
AUTH_CLIENT_SECRET=change_me_client_secret

# Optional multi-client JSON. Example:
# [{"clientId":"site-a","clientSecret":"secret-a","scopes":["mail:send"]}]
JWT_CLIENTS_JSON=

# Token endpoint rate limit
TOKEN_RATE_LIMIT_WINDOW_MS=60000
TOKEN_RATE_LIMIT_MAX=30

# API key value (required when AUTH_MODE=api_key)
API_KEY=

# =========================
# Global API rate limiter
# =========================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# =========================
# Queue and worker behavior
# =========================
# Queue backend: redis | memory (tests/dev)
QUEUE_BACKEND=redis
# Max in-memory queued jobs (used when QUEUE_BACKEND=memory)
QUEUE_MAX_SIZE=50000
# Number of parallel worker runners
WORKER_CONCURRENCY=2
# SMTP send attempts per job (including first attempt)
RETRY_ATTEMPTS=3
# Base retry delay in milliseconds (linear by attempt index)
RETRY_DELAY_MS=250
# Graceful shutdown drain timeout in milliseconds
SHUTDOWN_TIMEOUT_MS=20000

# =========================
# Redis mail queue (used when QUEUE_BACKEND=redis)
# =========================
REDIS_URL=redis://127.0.0.1:6379
REDIS_QUEUE_KEY=mailfastapi:mail_jobs
REDIS_COMMAND_TIMEOUT_MS=5000
# Redis processing lease. Expired processing jobs are requeued for at-least-once delivery.
QUEUE_VISIBILITY_TIMEOUT_MS=300000
QUEUE_RECLAIM_INTERVAL_MS=30000

# =========================
# Logging and storage
# =========================
# SQLite database path for structured system logs
LOG_DB_PATH=data/mailfastapi.sqlite
# SQLite database path for operational state: suppression, idempotency, DLQ, audit hash chain
OPERATIONAL_DB_PATH=data/mailfastapi-operational.sqlite
# Directory for JSONL/file logs
LOG_DIR=logs
# Main file log name
LOG_FILE_NAME=system.log
# Logger flush interval (buffer -> file/sqlite)
LOG_FLUSH_INTERVAL_MS=300

# =========================
# Live monitor dashboard
# =========================
# Enable built-in live monitor web UI + stream + Prometheus text endpoint
MONITOR_ENABLED=true
# Core service should usually expose data endpoints only.
# Keep false when running separate web panel service.
MONITOR_UI_ENABLED=false
# Base path for monitor UI (serves ${MONITOR_PATH}, ${MONITOR_PATH}/stats, ${MONITOR_PATH}/stream)
MONITOR_PATH=/monitor
# Optional dedicated bind host for monitor server (empty = same binding behavior as main app)
MONITOR_HOST=
# Optional dedicated monitor server port. Use a value different than PORT to run monitor on a separate port.
MONITOR_PORT=0
# Prometheus text metrics path
METRICS_PATH=/metrics
# SSE snapshot publish interval (ms)
MONITOR_SSE_INTERVAL_MS=1000
# Optional access token for core monitor + metrics endpoints (preferred header: x-monitor-token)
MONITOR_TOKEN=
# Max retained rows in monitor event table
MONITOR_MAX_RECENT_ENTRIES=400
# Timeline retention window in minutes
MONITOR_MAX_TIMELINE_MINUTES=180

# =========================
# Delivery safety and compliance
# =========================
# Idempotency prevents duplicate queue writes when clients retry the same request.
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_HEADER=idempotency-key
IDEMPOTENCY_TTL_MS=86400000
# Suppression applies by default to marketing/bulk categories.
SUPPRESSION_ENABLED=true
SUPPRESSION_APPLIES_TO=marketing,bulk
# Required for one-click unsubscribe links on marketing/bulk mail.
PUBLIC_BASE_URL=
UNSUBSCRIBE_SECRET=
# DKIM selectors checked by monitor domain-health endpoint.
DOMAIN_HEALTH_DKIM_SELECTORS=default,mail
# Delivery policy uses per-domain quotas for gmail/outlook/yahoo/corporate buckets.
DELIVERY_POLICY_ENABLED=true
DOMAIN_POLICIES_JSON=
SMTP_ACCOUNT_POLICIES_JSON=
# Bounce/complaint webhook ingestion token (x-webhook-token).
BOUNCE_WEBHOOK_ENABLED=true
BOUNCE_WEBHOOK_TOKEN=
# Dedicated bounce/return-path domain, e.g. bounces.example.com
BOUNCE_DOMAIN=
# DKIM signing. Production mode requires this to be enabled and configured.
DKIM_SIGNING_ENABLED=false
DKIM_DOMAIN=
DKIM_SELECTOR=
DKIM_PRIVATE_KEY_PATH=
DKIM_PRIVATE_KEY=
DKIM_KEYS_JSON=

# =========================
# Web panel service
# =========================
# Legacy web panel is served on fixed port 8080 at the root URL.
WEB_PORT=8080
WEB_HOST=0.0.0.0
# Core API base URL used by web service for proxying stats/stream/metrics
WEB_CORE_BASE_URL=http://127.0.0.1:3000
# Enable/disable updater integration exposed on monitor UI
WEB_ENABLE_UPDATER=true
# Updater script path (relative to project root or absolute)
WEB_UPDATE_SCRIPT=./scripts/updater.js
# Updater command timeout for web-triggered updates
WEB_UPDATE_TIMEOUT_MS=180000
# Optional extra token for update endpoints (x-update-token header only)
WEB_UPDATE_TOKEN=
# Web service graceful shutdown timeout
WEB_SHUTDOWN_TIMEOUT_MS=12000
# Web session hardening
WEB_MFA_REQUIRED=false
WEB_SESSION_IDLE_TIMEOUT_MS=28800000
WEB_SESSION_ABSOLUTE_TIMEOUT_MS=43200000
WEB_SESSION_BIND_IP=true

# =========================
# Secure updater behavior
# =========================
# branch = current upstream branch; tag = latest allowed release tag
UPDATER_RELEASE_MODE=branch
# Used only in tag mode when UPDATER_TARGET is empty
UPDATER_ALLOWED_TAG_PATTERN=^v[0-9]+\.[0-9]+\.[0-9]+$
# Set true to require signed annotated tags in tag mode
UPDATER_REQUIRE_SIGNED_TAG=false
# Optional explicit branch ref or tag, e.g. origin/main or v1.2.3
UPDATER_TARGET=
# Optional npm executable path when service PATH does not include npm
UPDATER_NPM_BIN=
# Run npm test during update apply
UPDATER_RUN_TESTS=false
# Post-restart health check timeout
UPDATER_HEALTH_TIMEOUT_MS=60000
# Stale updater lock cleanup threshold
UPDATER_LOCK_STALE_MS=1800000

# =========================
# Test-only
# =========================
# Real recipient for: npm test mailsend
TEST_MAIL_TO=

# =========================
# Overload test
# =========================
# Dry-run by default. Set true only when you intentionally want real mail traffic.
OVERLOAD_CONFIRM_REAL_SEND=false
# api-limit uses RATE_LIMIT_MAX + 25% attempts. smtp-provider defaults to at least 1000 attempts.
# max-performance defaults to 2000 attempts with high concurrency when OVERLOAD_TOTAL is empty.
OVERLOAD_PROFILE=api-limit
# Optional explicit sender account name from the encrypted SMTP account store.
OVERLOAD_SMTP_ACCOUNT=
# Optional override recipient. Defaults to TEST_MAIL_TO.
OVERLOAD_TEST_MAIL_TO=
# Optional explicit counts.
OVERLOAD_TOTAL=
OVERLOAD_CONCURRENCY=
OVERLOAD_BATCH_DELAY_MS=0
OVERLOAD_REQUEST_TIMEOUT_MS=15000
OVERLOAD_SUBJECT_PREFIX=MailFastApi overload test
OVERLOAD_MAIL_CATEGORY=transactional
OVERLOAD_TENANT_ID=overload_test
# Payload size per message. OVERLOAD_HTML_MB takes precedence when set.
OVERLOAD_HTML_MB=
OVERLOAD_HTML_BYTES=512
OVERLOAD_REPORT_PATH=
