{
  "name": "mailfastapi",
  "version": "1.0.0",
  "description": "High-performance Node.js email microservice with pooled SMTP and async queue worker",
  "main": "src/app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node scripts/start.js",
    "start:core": "node src/app.js",
    "start:web": "node src/web.js",
    "test": "node Tests/run-tests.js",
    "test:mailsend": "node Tests/run-tests.js mailsend",
    "test:load:k6": "k6 run Tests/load/k6-send.js",
    "test:load:autocannon": "node Tests/load/autocannon-send.js",
    "test:overload": "node Tests/load/overload-send.js",
    "retry:failed": "node scripts/retry-dead-letters.js",
    "update:check": "node scripts/updater.js --check",
    "update:apply": "node scripts/updater.js --apply --yes",
    "log": "node scripts/log-cli.js",
    "log:mailsender": "node scripts/log-cli.js mailsender"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.5",
    "redis": "^4.7.1"
  }
}
